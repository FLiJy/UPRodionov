<Page x:Class="UchebnayaPraktika.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="BorderFrozen" Background="#FFE5E5" BorderBrush="Red" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚠️ ВАШ АККАУНТ ЗАМОРОЖЕН" FontWeight="Bold" Foreground="Red" FontSize="18"/>
                        <TextBlock Text="Причина: Нарушение правил сообщества (множественные жалобы)." Margin="0,5,0,10"/>
                        <Button Content="Оспорить заморозку" Width="150" HorizontalAlignment="Left" Click="BtnAppealAccount_Click"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="150" Background="#DDD" CornerRadius="75" VerticalAlignment="Top">
                        <TextBlock Text="👤" FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="25,0,0,0">
                        <TextBlock x:Name="TbDisplayName" FontSize="28" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TbRole" FontSize="16" Foreground="Gray" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Логин: " FontWeight="Bold" Width="80"/>
                            <TextBlock x:Name="TbLogin"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="Email: " FontWeight="Bold" Width="80"/>
                            <TextBlock x:Name="TbEmail"/>
                        </StackPanel>

                        <Button x:Name="BtnRequestAuthor" Content="Стать автором" Width="150" Height="30" HorizontalAlignment="Left" Visibility="Collapsed" Click="BtnRequestAuthor_Click"/>
                        <TextBlock x:Name="TbAuthorStatus" Text="Заявка на автора на рассмотрении..." Foreground="Orange" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,30,0,20"/>

                <TextBlock Text="Мои отзывы" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                <ItemsControl x:Name="IcMyReviews">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="10" Margin="0,0,0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Books.Title}" FontWeight="Bold" Foreground="SteelBlue"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Оценка: " Foreground="Gray"/>
                                        <TextBlock Text="{Binding Rating}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Comment}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
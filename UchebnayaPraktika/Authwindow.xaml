<Window x:Class="UchebnayaPraktika.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="350" Width="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="gray">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вход в систему" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="TbLogin" Margin="0,5,0,10" Height="25"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="PbPassword" Margin="0,5,0,20" Height="25"/>

            <Button Content="Войти" Height="30" Click="BtnLogin_Click" Background="LimeGreen"/>
            <Button Content="Зарегистрироваться" Height="30" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="blue" Click="BtnRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>
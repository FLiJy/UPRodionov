<Page x:Class="UchebnayaPraktika.AddEditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование книги">

    <ScrollViewer Padding="20">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Название книги:" Margin="0,0,0,5"/>
            <TextBox x:Name="TbTitle" Margin="0,0,0,15"/>

            <TextBlock Text="Выберите жанр:" FontWeight="Bold" Margin="0,10,0,5"/>
            <ComboBox x:Name="ComboGenres" 
                      DisplayMemberPath="Name" 
                      SelectedValuePath="Id" 
                      Width="250" 
                      HorizontalAlignment="Left" 
                      Margin="0,0,0,15"/>

            <TextBlock Text="Обложка:" Margin="0,0,0,5"/>
            <Border BorderBrush="Gray" BorderThickness="1" Width="150" Height="220" HorizontalAlignment="Left" Margin="0,0,0,10">
                <Image x:Name="ImgPreview" Stretch="UniformToFill" />
            </Border>
            <Button Content="Выбрать файл..." Width="150" HorizontalAlignment="Left" Click="BtnSelectCover_Click" Margin="0,0,0,15"/>

            <TextBlock Text="Содержание (текст книги):" Margin="0,0,0,5"/>
            <TextBox x:Name="TbContent" Height="200" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

            <Button Content="Сохранить" Width="150" Height="35" Background="#2E8B57" Foreground="White" Click="BtnSave_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
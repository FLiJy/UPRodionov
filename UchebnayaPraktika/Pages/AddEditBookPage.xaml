<Page x:Class="UchebnayaPraktika.AddEditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактор книги">

    <Grid Margin="30">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock x:Name="TbHeader" Text="Новое произведение" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Название:"/>
            <TextBox x:Name="TbTitle" Margin="0,5,0,15" Height="25"/>

            <TextBlock Text="Описание:"/>
            <TextBox x:Name="TbDesc" Margin="0,5,0,15" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

            <TextBlock Text="Текст произведения:"/>
            <TextBox x:Name="TbContent" Margin="0,5,0,20" Height="200" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Сохранить" Width="120" Height="35" Background="#2E8B57" Foreground="White" Click="BtnSave_Click"/>
                <Button Content="Отмена" Width="120" Height="35" Margin="10,0,0,0" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
<Page x:Class="UchebnayaPraktika.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администрирование">

    <Grid Margin="15">
        <TabControl Background="White">

            <TabItem Header="Жалобы">
                <DataGrid x:Name="DgComplaints" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM HH:mm}"/>
                        <DataGridTextColumn Header="Отправитель" Binding="{Binding Users.DisplayName}"/>
                        <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                        <DataGridTemplateColumn Header="Действие" Width="230">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Отклонить" Margin="2" Padding="10,2" Click="BtnRejectComplaint_Click" Tag="{Binding}"/>
                                        <Button Content="Заморозить объект" Margin="2" Padding="10,2" Background="#FFE5E5" Click="BtnFreezeTarget_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Заявки на автора">
                <DataGrid x:Name="DgRoleRequests" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Users.Login}"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"/>
                        <DataGridTemplateColumn Header="Решение" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Одобрить" Margin="2" Padding="10,2" Click="BtnApproveAuthor_Click" Tag="{Binding}" Foreground="Green"/>
                                        <Button Content="Отклонить" Margin="2" Padding="10,2" Click="BtnRejectAuthor_Click" Tag="{Binding}" Foreground="Red"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Разморозка">
                <DataGrid x:Name="DgUnfreeze" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Кто просит" Binding="{Binding Users.DisplayName}" Width="150"/>
                        <DataGridTextColumn Header="Объект (Книга)" Binding="{Binding Books.Title}" Width="*"/>
                        <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="200"/>
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Разморозить" Margin="2" Padding="10,2" Click="BtnUnfreeze_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Пользователи">
                <DataGrid x:Name="DgUsers" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding Roles.Name}"/>
                        <DataGridTemplateColumn Header="Управление" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Сменить роль" Margin="2" Padding="5,2" Click="BtnChangeRole_Click" Tag="{Binding}"/>
                                        <Button Content="Сброс пароля" Margin="2" Padding="5,2" Click="BtnResetPass_Click" Tag="{Binding}"/>

                                        <Button Content="Заморозить" Margin="2" Padding="5,2" Click="BtnFreezeUser_Click" Tag="{Binding}" 
                                                Visibility="{Binding IsFrozen, Converter={StaticResource VisibilityConverter}, ConverterParameter=invert}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
<Page x:Class="UchebnayaPraktika.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница книги">

    <Grid>
        <ScrollViewer Margin="15" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="280" Background="#ECECEC" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="Нет обложки" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
             
                             <Image x:Name="ImgBookCover" 
                           Source="{Binding CoverPath, Converter={StaticResource ImgConv}}" 
                           Stretch="UniformToFill" />   
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock x:Name="TbTitle" FontWeight="Bold" FontSize="24" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TbAuthor" Foreground="DimGray" FontSize="16" Margin="0,5,0,10" FontStyle="Italic"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Рейтинг: " FontWeight="Bold"/>
                            <TextBlock Text="⭐ " Foreground="Gold"/>
                            <TextBlock x:Name="TbRating" Text="0.0" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Жанры: " FontWeight="Bold"/>
                            <TextBlock x:Name="TbGenres" TextWrapping="Wrap" Foreground="#4A4A4A"/>
                        </StackPanel>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Читать книгу" Height="35" Width="120" Margin="0,0,10,10" Background="#2E8B57" Foreground="White" Click="BtnRead_Click"/>
                            <Button Content="Пожаловаться на книгу" Height="35" Width="150" Margin="0,0,10,10" Click="BtnComplainBook_Click"/>
                            <Button Content="Пожаловаться на автора" Height="35" Width="160" Margin="0,0,10,10" Click="BtnComplainAuthor_Click"/>

                            <Button x:Name="BtnFreezeBook" Content="❄ Заморозить книгу" Height="35" Width="140" Margin="0,0,10,10" 
                                    Background="IndianRed" Foreground="White" Visibility="Collapsed" Click="BtnFreezeBook_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Описание" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                <TextBlock x:Name="TbDescription" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20"/>

                <Border x:Name="PanelReading" Background="#FDFDFD" BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Текст книги" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
                            <Button Content="Закрыть текст" HorizontalAlignment="Right" Width="100" Height="25" Click="BtnCloseReading_Click"/>
                        </Grid>
                        <TextBox x:Name="TbBookText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="400" Background="Transparent" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Separator Margin="0,10,0,20"/>

                <TextBlock Text="Отзывы" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>

                <Border Background="#F9F9F9" Padding="15" CornerRadius="8" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Оставить отзыв" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Оценка (1-10): " VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbNewRating" Width="60" SelectedIndex="9">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="10"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBox x:Name="TbNewReviewText" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" Tag="Напишите ваш отзыв здесь..."/>
                        <Button Content="Отправить отзыв" Width="130" Height="30" HorizontalAlignment="Left" Click="BtnSubmitReview_Click"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="IcReviews">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding AuthorName}" FontWeight="Bold"/>
                                            <TextBlock Text="  |  Оценка: " Foreground="Gray"/>
                                            <TextBlock Text="{Binding Rating}" FontWeight="Bold" Foreground="Gold"/>
                                            <TextBlock Text="/10" Foreground="Gray"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" HorizontalAlignment="Right" Foreground="Gray" FontSize="11"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" Margin="0,10,0,10"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Пожаловаться" Height="22" Width="90" Background="Transparent" BorderThickness="0" Foreground="SteelBlue" 
                                                Click="BtnComplainReview_Click" Tag="{Binding Id}"/>

                                        <Button Content="❄ Заморозить" Height="22" Width="90" Margin="10,0,0,0" Background="Transparent" BorderThickness="0" Foreground="IndianRed" 
                                                Visibility="{Binding AdminButtonVisibility}" Click="BtnFreezeReview_Click" Tag="{Binding Id}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="OverlayComplaint" Background="#88000000" Visibility="Collapsed">
            <Border Background="White" Width="400" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="TbComplaintTitle" Text="Жалоба" FontWeight="Bold" FontSize="18" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="Опишите причину жалобы:" Margin="0,0,0,5"/>
                    <TextBox x:Name="TbComplaintReason" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Отправить" Width="100" Height="30" Margin="0,0,15,0" Background="IndianRed" Foreground="White" Click="BtnSubmitComplaint_Click"/>
                        <Button Content="Отмена" Width="100" Height="30" Click="BtnCancelComplaint_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
<Page x:Class="UchebnayaPraktika.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мой профиль">

    <Grid Margin="30">
        <StackPanel HorizontalAlignment="Center">
            <Ellipse Width="150" Height="150" Stroke="LightGray" StrokeThickness="2">
                <Ellipse.Fill>
                    <ImageBrush x:Name="ImgAvatar" Stretch="UniformToFill" ImageSource="\Images\deafault-avatar.png"/>
                </Ellipse.Fill>
            </Ellipse>

            <Button Content="Сменить фото" Margin="0,10,0,20" Click="BtnChangePhoto_Click"/>
            <Border Background="#FF6B6B" Padding="10" Margin="0,0,0,15"
        Visibility="{Binding IsFrozen, Converter={StaticResource VisibilityConverter}}">
                <TextBlock Text="Ваш аккаунт (или книги) заморожены администратором!" 
               Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="Ваше имя:" FontWeight="Bold"/>
            <TextBox x:Name="TbDisplayName" Width="250" Margin="0,5,0,15"/>

            <Button Content="Сохранить изменения" Background="#2E8B57" Foreground="White" Height="30" Click="BtnSaveProfile_Click"/>
        </StackPanel>
    </Grid>
</Page>
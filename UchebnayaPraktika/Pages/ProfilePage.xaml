<Page x:Class="UchebnayaPraktika.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мой профиль">

    <Grid Margin="30">
        <StackPanel HorizontalAlignment="Center">
            <Ellipse Width="150" Height="150" Stroke="LightGray" StrokeThickness="2">
                <Ellipse.Fill>
                    <ImageBrush x:Name="ImgAvatar" Stretch="UniformToFill" ImageSource="\Images\deafault-avatar.png"/>
                </Ellipse.Fill>
            </Ellipse>

            <Button Content="Сменить фото" Margin="0,10,0,20" Click="BtnChangePhoto_Click"/>

            <Border Background="#FF6B6B" Padding="15" Margin="0,0,0,15" CornerRadius="5"
                    Visibility="{Binding IsFrozen, Converter={StaticResource VisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Ваш аккаунт заморожен администратором!" 
                               Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="BtnAppeal" Content="Подать апелляцию" Margin="0,10,0,0" 
                            Height="30" Background="White" Foreground="#FF6B6B" FontWeight="Bold"
                            Click="BtnAppeal_Click"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Ваше имя:" FontWeight="Bold"/>
            <TextBox x:Name="TbDisplayName" Width="250" Margin="0,5,0,15"/>

            <Button Content="Сохранить изменения" Background="#2E8B57" Foreground="White" Height="30" Click="BtnSaveProfile_Click"/>
        </StackPanel>
    </Grid>
</Page>